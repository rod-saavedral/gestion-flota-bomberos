<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bomberos_company_assigned" model="ir.rule">
        <field name="name">Compañías asignadas al usuario</field>
        <field name="model_id" ref="model_bomberos_company"/>
        <field name="domain_force">[('id', 'in', user.bomberos_company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_bomberos_consultant'))]"/>
    </record>
    <record id="rule_bomberos_company_manager_all" model="ir.rule">
        <field name="name">Jefatura accede a todas las compañías</field>
        <field name="model_id" ref="model_bomberos_company"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_bomberos_fleet_manager'))]"/>
    </record>
</odoo>
