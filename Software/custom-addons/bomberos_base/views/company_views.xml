<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bomberos_company_list" model="ir.ui.view">
        <field name="name">bomberos.company.list</field>
        <field name="model">bomberos.company</field>
        <field name="arch" type="xml">
            <list string="Compañías">
                <field name="code"/>
                <field name="name"/>
                <field name="currency_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_bomberos_company_form" model="ir.ui.view">
        <field name="name">bomberos.company.form</field>
        <field name="model">bomberos.company</field>
        <field name="arch" type="xml">
            <form string="Compañía">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nombre de la compañía"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="currency_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Acceso">
                        <field name="user_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bomberos_company" model="ir.actions.act_window">
        <field name="name">Compañías</field>
        <field name="res_model">bomberos.company</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
