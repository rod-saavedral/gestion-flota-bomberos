<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bomberos_vehicle_search" model="ir.ui.view">
        <field name="name">bomberos.vehicle.search</field>
        <field name="model">bomberos.vehicle</field>
        <field name="arch" type="xml">
            <search string="Buscar vehículos">
                <field name="name"/>
                <field name="code"/>
                <field name="license_plate"/>
                <field name="company_id"/>
                <field name="operational_state"/>
                <filter name="available" string="Disponibles"
                        domain="[('operational_state', '=', 'available')]"/>
                <filter name="in_maintenance" string="En mantención"
                        domain="[('operational_state', '=', 'in_maintenance')]"/>
                <filter name="unavailable" string="Fuera de servicio"
                        domain="[('operational_state', '=', 'unavailable')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'vehicle_type'}"/>
                    <filter name="group_state" string="Estado operativo" context="{'group_by': 'operational_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_bomberos_vehicle_list" model="ir.ui.view">
        <field name="name">bomberos.vehicle.list</field>
        <field name="model">bomberos.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehículos" decoration-danger="operational_state == 'unavailable'"
                  decoration-warning="operational_state == 'in_maintenance'">
                <field name="code"/>
                <field name="name"/>
                <field name="license_plate"/>
                <field name="company_id"/>
                <field name="vehicle_type"/>
                <field name="operational_state" widget="badge"/>
                <field name="current_odometer_km"/>
            </list>
        </field>
    </record>
    <record id="view_bomberos_vehicle_form" model="ir.ui.view">
        <field name="name">bomberos.vehicle.form</field>
        <field name="model">bomberos.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehículo">
                <header>
                    <button name="action_set_available" type="object" string="Marcar disponible"
                            groups="bomberos_base.group_bomberos_fleet_manager"
                            invisible="operational_state != 'unavailable'"/>
                    <button name="action_set_unavailable" type="object" string="Fuera de servicio"
                            groups="bomberos_base.group_bomberos_fleet_manager"
                            invisible="operational_state != 'available'"/>
                    <field name="operational_state" widget="statusbar"
                           statusbar_visible="available,in_maintenance,unavailable"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_odometer" type="object" class="oe_stat_button"
                                icon="fa-tachometer">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Kilometraje</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej.: Unidad B-01"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="license_plate"/>
                            <field name="company_id"/>
                            <field name="vehicle_type"/>
                        </group>
                        <group>
                            <field name="make"/>
                            <field name="model_name"/>
                            <field name="year"/>
                            <field name="current_odometer_km"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Datos técnicos">
                            <group>
                                <field name="vin"/>
                                <field name="engine_number"/>
                                <field name="capacity"/>
                            </group>
                        </page>
                        <page string="Documentos">
                            <field name="document_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Kilometraje">
                            <field name="odometer_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="km"/>
                                    <field name="user_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_bomberos_odometer_list" model="ir.ui.view">
        <field name="name">bomberos.vehicle.odometer.list</field>
        <field name="model">bomberos.vehicle.odometer</field>
        <field name="arch" type="xml">
            <list string="Lecturas de kilometraje">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="company_id"/>
                <field name="km"/>
                <field name="user_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>
    <record id="view_bomberos_odometer_form" model="ir.ui.view">
        <field name="name">bomberos.vehicle.odometer.form</field>
        <field name="model">bomberos.vehicle.odometer</field>
        <field name="arch" type="xml">
            <form string="Lectura de kilometraje">
                <sheet>
                    <group>
                        <field name="vehicle_id"/>
                        <field name="company_id"/>
                        <field name="date"/>
                        <field name="km"/>
                        <field name="user_id"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bomberos_vehicle" model="ir.actions.act_window">
        <field name="name">Vehículos</field>
        <field name="res_model">bomberos.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bomberos_vehicle_search"/>
    </record>
    <record id="action_bomberos_odometer" model="ir.actions.act_window">
        <field name="name">Lecturas de kilometraje</field>
        <field name="res_model">bomberos.vehicle.odometer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
