<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bomberos_maintenance_search" model="ir.ui.view">
        <field name="name">bomberos.maintenance.order.search</field>
        <field name="model">bomberos.maintenance.order</field>
        <field name="arch" type="xml">
            <search string="Buscar mantenciones">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="company_id"/>
                <field name="maintenance_type"/>
                <field name="state"/>
                <filter name="filter_preventive" string="Preventivas"
                        domain="[('maintenance_type', '=', 'preventive')]"/>
                <filter name="filter_reactive" string="Reactivas"
                        domain="[('maintenance_type', '=', 'reactive')]"/>
                <filter name="filter_active" string="Abiertas"
                        domain="[('state', 'not in', ('done', 'cancelled'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}"/>
                    <filter name="group_vehicle" string="Vehículo" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'maintenance_type'}"/>
                    <filter name="group_date" string="Fecha programada" context="{'group_by': 'scheduled_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_bomberos_maintenance_list" model="ir.ui.view">
        <field name="name">bomberos.maintenance.order.list</field>
        <field name="model">bomberos.maintenance.order</field>
        <field name="arch" type="xml">
            <list string="Órdenes de mantención"
                  decoration-danger="state == 'review'"
                  decoration-warning="state == 'scheduled'">
                <field name="name"/>
                <field name="scheduled_date"/>
                <field name="vehicle_id"/>
                <field name="company_id"/>
                <field name="maintenance_type"/>
                <field name="state" widget="badge"/>
                <field name="total_cost" sum="Costo total"/>
            </list>
        </field>
    </record>
    <record id="view_bomberos_maintenance_form" model="ir.ui.view">
        <field name="name">bomberos.maintenance.order.form</field>
        <field name="model">bomberos.maintenance.order</field>
        <field name="arch" type="xml">
            <form string="Orden de mantención">
                <header>
                    <button name="action_schedule" type="object" string="Programar"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="bomberos_base.group_bomberos_technician"/>
                    <button name="action_start" type="object" string="Iniciar"
                            class="btn-primary" invisible="state != 'scheduled'"
                            groups="bomberos_base.group_bomberos_technician"/>
                    <button name="action_submit_review" type="object" string="Solicitar revisión"
                            class="btn-primary" invisible="state != 'in_progress'"
                            groups="bomberos_base.group_bomberos_technician"/>
                    <button name="action_close" type="object" string="Cerrar"
                            class="btn-primary" invisible="state != 'review'"
                            groups="bomberos_base.group_bomberos_fleet_manager"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state not in ('draft', 'scheduled')"
                            groups="bomberos_base.group_bomberos_fleet_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scheduled,in_progress,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="maintenance_type" readonly="state != 'draft'"/>
                            <field name="vehicle_id" readonly="state != 'draft'"/>
                            <field name="company_id"/>
                            <field name="scheduled_date" readonly="state not in ('draft', 'scheduled')"/>
                            <field name="due_odometer_km" readonly="state not in ('draft', 'scheduled')"/>
                        </group>
                        <group>
                            <field name="created_by"/>
                            <field name="started_at"/>
                            <field name="completed_at"/>
                            <field name="reviewer_id"/>
                            <field name="reviewed_at"/>
                            <field name="odometer_km" readonly="state not in ('in_progress', 'review')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Falla y trabajo">
                            <group>
                                <field name="failure_description"
                                       readonly="state not in ('draft', 'scheduled', 'in_progress')"/>
                                <field name="diagnosis"
                                       readonly="state not in ('draft', 'scheduled', 'in_progress')"/>
                                <field name="work_description"
                                       readonly="state not in ('draft', 'scheduled', 'in_progress')"/>
                            </group>
                        </page>
                        <page string="Materiales y repuestos">
                            <field name="material_line_ids"
                                   readonly="state not in ('draft', 'scheduled', 'in_progress')">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"><!-- Required by the monetary subtotal widget. --></field>
                                </list>
                            </field>
                        </page>
                        <page string="Mano de obra">
                            <field name="labor_line_ids"
                                   readonly="state not in ('draft', 'scheduled', 'in_progress')">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="hours"/>
                                    <field name="hourly_rate"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"><!-- Required by the monetary subtotal widget. --></field>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="material_cost"/>
                        <field name="labor_cost"/>
                        <field name="total_cost" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_bomberos_maintenance_graph" model="ir.ui.view">
        <field name="name">bomberos.maintenance.order.graph</field>
        <field name="model">bomberos.maintenance.order</field>
        <field name="arch" type="xml">
            <graph string="Costos de mantención por compañía" type="bar">
                <field name="company_id" type="row"/>
                <field name="total_cost" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_bomberos_maintenance_pivot" model="ir.ui.view">
        <field name="name">bomberos.maintenance.order.pivot</field>
        <field name="model">bomberos.maintenance.order</field>
        <field name="arch" type="xml">
            <pivot string="Seguimiento de mantenciones">
                <field name="company_id" type="row"/>
                <field name="maintenance_type" type="col"/>
                <field name="total_cost" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_bomberos_maintenance" model="ir.actions.act_window">
        <field name="name">Órdenes de mantención</field>
        <field name="res_model">bomberos.maintenance.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bomberos_maintenance_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
    <record id="action_bomberos_maintenance_reports" model="ir.actions.act_window">
        <field name="name">Costos y seguimiento</field>
        <field name="res_model">bomberos.maintenance.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_bomberos_maintenance_search"/>
    </record>
</odoo>
