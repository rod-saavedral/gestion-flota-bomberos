<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bomberos_maintenance_assigned" model="ir.rule">
        <field name="name">Mantenciones de compañías asignadas</field>
        <field name="model_id" ref="model_bomberos_maintenance_order"/>
        <field name="domain_force">[('company_id', 'in', user.bomberos_company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('bomberos_base.group_bomberos_consultant'))]"/>
    </record>
    <record id="rule_bomberos_maintenance_manager_all" model="ir.rule">
        <field name="name">Jefatura accede a todas las mantenciones</field>
        <field name="model_id" ref="model_bomberos_maintenance_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bomberos_base.group_bomberos_fleet_manager'))]"/>
    </record>
